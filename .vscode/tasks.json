      "args": [
        "-NoProfile",
        "-Command",
        "Remove-Item -Force -ErrorAction SilentlyContinue -Path main.aux,main.log,main.out,main.synctex.gz,main.toc,main.lof,main.lot,main.fls,main.fdb_latexmk,main.bbl,main.blg,main.bcf,main.run.xml,main.xdv,example.aux,example.log,example.out,example.synctex.gz,example.toc,example.lof,example.lot,example.fls,example.fdb_latexmk,example.bbl,example.blg,example.bcf,example.run.xml,example.xdv; exit 0"
